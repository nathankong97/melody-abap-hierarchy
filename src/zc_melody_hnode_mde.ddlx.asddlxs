@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Hierarchy Node',
  typeNamePlural: 'Hierarchy Nodes',
  title: {
    type: #STANDARD,
    value: 'NodeName'
  }
}

annotate entity ZC_MELODY_HNODE with
{
  @UI.lineItem: [
    { position: 10, importance: #HIGH, label: 'Node' }
  ]
  NodeName;

  @UI.lineItem: [
    { position: 20, importance: #HIGH, label: 'Node ID' }
  ]
  NodeId;

  @UI.lineItem: [
    { position: 30, importance: #MEDIUM, label: 'Parent ID' }
  ]
  ParentId;

  @UI.lineItem: [
    { position: 40, importance: #MEDIUM, label: 'Node Type' }
  ]
  NodeType;

  @UI.lineItem: [
    { position: 50, importance: #LOW, label: 'Sort Order' }
  ]
  SortOrder;
}